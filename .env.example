# Copia este archivo a .env y completa tus claves. .env está en .gitignore: nunca lo subas al repo.

# Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Alpaca (https://app.alpaca.markets) -> usa primero las claves de la cuenta PAPER
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_DATA_FEED=iex

# paper | live. Live además exige AGENTRADE_LIVE_CONFIRM=I_UNDERSTAND_REAL_MONEY_IS_AT_RISK
AGENTRADE_MODE=paper
AGENTRADE_WATCHLIST=SPY,QQQ,AAPL,MSFT,NVDA,AMZN

# Agente
AGENTRADE_MODEL=claude-opus-5-5
AGENTRADE_EFFORT=medium
AGENTRADE_ENABLE_WEB_SEARCH=0
AGENTRADE_CYCLE_MINUTES=60
AGENTRADE_MAX_CYCLES_PER_DAY=8
AGENTRADE_REPORT_LANGUAGE=español

# Límites de riesgo (se aplican en código, el agente no puede saltárselos)
AGENTRADE_MAX_POSITION_PCT=0.20
AGENTRADE_MAX_GROSS_EXPOSURE_PCT=1.0
AGENTRADE_MAX_OPEN_POSITIONS=8
AGENTRADE_MAX_ORDER_NOTIONAL=25000
AGENTRADE_MAX_DAILY_LOSS_PCT=0.03
AGENTRADE_MAX_ORDERS_PER_DAY=20
AGENTRADE_REQUIRE_STOP_LOSS=1
AGENTRADE_MAX_STOP_DISTANCE_PCT=0.15
AGENTRADE_ALLOW_SHORT=0
